    {
      "name": "2. Product Launch APIs (Stage 2)",
      "description": "Exchanges session JWT for the authentic legacy application payloads. Optional device telemetry fields (device_id, registration_id/fcm_token, device_type, app_version) can be sent in the JSON body.",
      "item": [
        {
          "name": "Launch Star Stellar (JSON format)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"emulator-5554\",\n  \"registration_id\": \"fcm_token_stellar_sample\",\n  \"device_type\": \"ANDROID\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/launch/star_steller",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "launch", "star_steller"]
            },
            "description": "Launches Star Stellar. Returns legacy JSON structure with process_status=YES, user details, and profile picture URL."
          }
        },
        {
          "name": "Launch Star SFA (XML format)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"emulator-5554\",\n  \"registration_id\": \"fcm_token_sfa_sample\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/launch/star_sfa",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "launch", "star_sfa"]
            },
            "description": "Launches Star SFA. Returns legacy XML payload matching emplogin-check-6.0.1.php."
          }
        },
        {
          "name": "Launch Star Saathi (Encrypted Hex format)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"emulator-5554\",\n  \"registration_id\": \"fcm_token_saathi_sample\",\n  \"device_type\": \"ANDROID\",\n  \"app_version\": \"6.0\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/launch/star_saathi",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "launch", "star_saathi"]
            },
            "description": "Launches Star Saathi. Returns AES-128-CBC encrypted hex response matching customer-login-6.0.1.php."
          }
        },
        {
          "name": "Launch Star Link (JSON format)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_type\": \"ANDROID\",\n  \"device_name\": \"Samsung Galaxy S22\",\n  \"app_version\": \"1.0.0\",\n  \"fcm_token\": \"fcm_token_link_sample\",\n  \"preferred_app_lang\": \"en\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/launch/star_link",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "launch", "star_link"]
            },
            "description": "Launches Star Link. Returns JSON profile with Passport OAuth token, mason points, category, and linked dealers."
          }
        },
        {
          "name": "Launch Dynamic (using {{product_key}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"emulator-5554\",\n  \"device_type\": \"ANDROID\",\n  \"registration_id\": \"fcm_token_sample\",\n  \"app_version\": \"1.0.0\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/launch/{{product_key}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "launch", "{{product_key}}"]
            },
            "description": "Dynamic launch request using collection variable {{product_key}}."
          }
        }
      ]
    },
