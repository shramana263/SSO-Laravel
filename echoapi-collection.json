    {
      "name": "6. Error Scenarios",
      "item": [
        {
          "name": "Send OTP - Non-existent user (expect 404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"0000000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/send-otp",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "send-otp"]
            },
            "description": "Expect 404 {\"status\":false,\"message\":\"User not found\"}. Same result for real phones that were FILTERED OUT during sync (acedns='N' employees/customers, INACTIVE engineers, dirty numbers)."
          }
        },
        {
          "name": "Send OTP - Missing mobile_number (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/send-otp",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "send-otp"]
            },
            "description": "Expect 422 Laravel validation error"
          }
        },
        {
          "name": "Verify OTP - Wrong code (expect 401 INVALID_OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"9239674825\",\n  \"otp\": \"000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/sso/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "verify-otp"]
            },
            "description": "Run 'Send OTP - BISWARUP' first. Expect 401 with code=INVALID_OTP. After 3 bad attempts: MAX_ATTEMPTS_EXCEEDED. NOTE: each verify consumes the OTP — re-run send-otp before retrying."
          }
        },
        {
          "name": "Launch - Invalid product key (expect 404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/sso/launch/invalid_product",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "launch", "invalid_product"]
            },
            "description": "Expect 404 {\"status\":false,\"message\":\"Invalid product key\"}. NOTE: requires a fresh {{auth_token}} — run Verify OTP first, otherwise you get 401 Unauthenticated."
          }
        },
        {
          "name": "Launch - Invalid token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer invalid_token_here" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/sso/launch/star_link",
              "host": ["{{base_url}}"],
              "path": ["v1", "sso", "launch", "star_link"]
            },
            "description": "Expect 401 {\"message\":\"Unauthenticated.\"}"
          }
        }
      ]
    }
